# live-build build artifacts and stage outputs.
# These are regenerated by `lb build` and are far too large to version
# (the bootstrap cache alone is ~300MB of .deb files).

/.build/
/binary/
/binary_*/
/cache/
/chroot/
/chroot_*/
/source/

# Built images, manifests and checksums
*.iso
*.img
*.files
*.contents
*.packages
*.sha256
*.sha512
*.md5
*.zsync
/live-image-*
